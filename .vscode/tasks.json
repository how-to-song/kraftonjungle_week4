{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "make: build active file",
            "command": "make",
            "args": [
                "-C", "${workspaceFolder}/Data-Structures",
                "build/${fileDirnameBasename}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "컴파일러: /usr/bin/gcc"
        }
    ]
}